# Kith — rootless Quadlet unit (Podman → systemd).
#
#   install -m 0644 kith.container ~/.config/containers/systemd/kith.container
#   systemctl --user daemon-reload && systemctl --user start kith
#   loginctl enable-linger "$USER"        # survive logout and reboot
#
# Data directory is created on the host with:
#   sudo install -d -o "$USER" -g "$USER" -m 0700 /srv/kith/data
# (outside /home on purpose — see 02-architecture.md §16)

[Unit]
Description=Kith — name & face trainer
After=network-online.target

[Container]
Image=localhost/kith:0.7.0
ContainerName=kith
PublishPort=127.0.0.1:8080:8080
Volume=/srv/kith/data:/data:Z
# The image runs as uid/gid 10001; keep-id with an explicit uid/gid is what maps
# that to the host user, so the bind-mounted /data stays writable without root.
UserNS=keep-id:uid=10001,gid=10001
EnvironmentFile=%h/.config/kith/kith.env
HealthCmd=python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=4).status==200 else 1)"
HealthInterval=30s
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
