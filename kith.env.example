# Copy to ~/.config/kith/kith.env and chmod 600. Values here are environment, never
# code. The container reads this file via the Quadlet unit's EnvironmentFile=.

# ── login gate ────────────────────────────────────────────────────────────────
# off = no login at all, which is only safe while the port is bound to loopback.
# on  = every page and /api path needs the password. /api/health stays public but
#       answers a trimmed payload, because the container healthcheck probes it.
KITH_AUTH=off

# An scrypt hash, never a plaintext password. Generate it inside the running container:
#   podman exec -it kith python -m app.cli hash-password
# Keep the surrounding single quotes: the value contains $ characters, and both the
# systemd and the podman env-file parsers are safest with it quoted. (They disagree
# about what to do with those quotes — podman's --env-file keeps them, systemd's
# EnvironmentFile strips them — so the app strips one layer itself and either path
# works. Verify with: podman exec kith python -m app.cli check-password)
KITH_PASSWORD_HASH=''

# Signs the session cookie. Set it to something random so logins survive a restart;
# if it is empty the app generates one per process and warns at startup.
#   head -c 32 /dev/urandom | base64
KITH_SESSION_SECRET=

KITH_SESSION_DAYS=30

# Turn on when the app is reached over HTTPS (i.e. behind Caddy). Leave off on plain
# http://127.0.0.1, where a Secure cookie would simply never be sent back.
KITH_SECURE_COOKIES=off

# ── storage & display ─────────────────────────────────────────────────────────
KITH_MAX_UPLOAD_MB=25

# Display timezone only — everything is stored as UTC.
TZ=Europe/Zurich

KITH_LOG_LEVEL=info
KITH_DATA_DIR=/data
KITH_PORT=8080
